{
  "id": "swag-labs-v1.0",
  "spec": "swag-labs.md",
  "note": "人工编写的黄金清单，对应 swag-labs.md。它由人写、不由模型生成——Coverage 这个数的全部意义来自这一点。标 heldOut 的条目从不参与任何调参，只在评测时使用。 匹配是确定性关键词规则，可复现，代价是措辞差异会漏判，所以这个数是**下界**。关键词双语：被测站点界面是英文、规格是中文，产出可能落在任一侧，只认一种语言的尺子会系统性低估诚实的工作。 已知偏差写在 swag-labs.md 的开头：这份素材的作者读过站点的实际行为，所以本清单量的是「能不能把素材拆成用例」，不是「能不能补上素材没写的东西」。",
  "items": [
    {
      "id": "G-01",
      "story": "US-01",
      "title": "有效凭证登录后进入商品列表页",
      "designMethod": "equivalence",
      "expectTier": 1,
      "match": {
        "anyOf": ["standard_user", "secret_sauce", "有效凭证", "正确的用户名和密码", "valid credentials", "登录成功"],
        "assertAnyOf": ["inventory.html", "products", "商品列表", "产品列表"]
      }
    },
    {
      "id": "G-02",
      "story": "US-02",
      "title": "密码错误时给出不区分用户名与密码的统一错误",
      "designMethod": "equivalence",
      "expectTier": 1,
      "match": {
        "anyOf": ["wrong password", "错误的密码", "密码不正确", "incorrect password", "invalid password"],
        "assertAnyOf": ["do not match any user", "不匹配", "用户名和密码", "username and password"]
      }
    },
    {
      "id": "G-03",
      "story": "US-02",
      "title": "用户名不存在时的错误文案与密码错误完全一致（不泄露账号是否存在）",
      "designMethod": "boundary",
      "expectTier": 1,
      "heldOut": true,
      "match": {
        "anyOf": ["不存在的用户", "不存在的账号", "nonexistent user", "unknown user", "no_such_user", "未注册"],
        "assertAnyOf": ["do not match any user", "相同", "一致", "same error", "username and password"]
      }
    },
    {
      "id": "G-04",
      "story": "US-03",
      "title": "用户名为空时提示 Username is required",
      "designMethod": "boundary",
      "expectTier": 1,
      "match": {
        "anyOf": ["用户名为空", "用户名留空", "empty username", "username empty", "不填用户名", "without username"],
        "assertAnyOf": ["username is required", "用户名是必填", "用户名必填", "需要用户名"]
      }
    },
    {
      "id": "G-05",
      "story": "US-03",
      "title": "密码为空时提示 Password is required",
      "designMethod": "boundary",
      "expectTier": 1,
      "match": {
        "anyOf": ["密码为空", "密码留空", "empty password", "password empty", "不填密码", "without password"],
        "assertAnyOf": ["password is required", "密码是必填", "密码必填", "需要密码"]
      }
    },
    {
      "id": "G-06",
      "story": "US-03",
      "title": "两项都为空时只提示第一个缺失项（用户名）",
      "designMethod": "boundary",
      "expectTier": 1,
      "heldOut": true,
      "match": {
        "anyOf": ["都为空", "都留空", "均为空", "both empty", "both fields empty", "全部为空"],
        "assertAnyOf": ["username is required", "用户名", "只提示", "first"]
      }
    },
    {
      "id": "G-07",
      "story": "US-04",
      "title": "被锁定账号即使密码正确也被拒绝",
      "designMethod": "state-transition",
      "expectTier": 1,
      "match": {
        "anyOf": ["locked_out_user", "被锁定", "锁定账号", "locked out", "locked account"],
        "assertAnyOf": ["locked out", "已被锁定", "锁定"]
      }
    },
    {
      "id": "G-08",
      "story": "US-05",
      "title": "未登录直接访问 /inventory.html 被弹回登录页",
      "designMethod": "state-transition",
      "expectTier": 1,
      "match": {
        "anyOf": ["未登录", "not logged in", "直接访问", "directly access", "without logging in", "未登录状态"],
        "assertAnyOf": ["only access", "登录后", "弹回", "重定向", "redirect", "login page", "登录页"]
      }
    },
    {
      "id": "G-09",
      "story": "US-06",
      "title": "商品列表共 6 件商品",
      "designMethod": "equivalence",
      "expectTier": 1,
      "match": {
        "anyOf": ["商品列表", "product list", "inventory", "商品数量", "浏览商品"],
        "assertAnyOf": ["6", "六件", "六个", "six"]
      }
    },
    {
      "id": "G-10",
      "story": "US-06",
      "title": "商品价格与规格一致（如 Backpack $29.99）",
      "designMethod": "equivalence",
      "expectTier": 1,
      "match": {
        "anyOf": ["backpack", "背包", "价格", "price"],
        "assertAnyOf": ["29.99", "$29.99"]
      }
    },
    {
      "id": "G-11",
      "story": "US-07",
      "title": "按价格从低到高排序后首件为 Onesie（$7.99）",
      "designMethod": "state-transition",
      "expectTier": 1,
      "match": {
        "anyOf": ["price (low to high)", "价格从低到高", "低到高", "lohi", "按价格升序"],
        "assertAnyOf": ["onesie", "7.99", "$7.99"]
      }
    },
    {
      "id": "G-12",
      "story": "US-07",
      "title": "按名称 Z-A 排序后首件为 Test.allTheThings() T-Shirt (Red)",
      "designMethod": "state-transition",
      "expectTier": 1,
      "heldOut": true,
      "match": {
        "anyOf": ["name (z to a)", "z to a", "z-a", "名称从z到a", "倒序", "逆序"],
        "assertAnyOf": ["test.allthethings", "allthethings", "red"]
      }
    },
    {
      "id": "G-13",
      "story": "US-09",
      "title": "加入购物车后按钮变为 Remove",
      "designMethod": "state-transition",
      "expectTier": 1,
      "match": {
        "anyOf": ["add to cart", "加入购物车", "添加到购物车"],
        "assertAnyOf": ["remove", "移除", "移出"]
      }
    },
    {
      "id": "G-14",
      "story": "US-09",
      "title": "加入两件商品后购物车角标显示 2",
      "designMethod": "boundary",
      "expectTier": 1,
      "match": {
        "anyOf": ["两件", "两个商品", "two items", "2 items", "两款"],
        "assertAnyOf": ["2", "角标", "badge"]
      }
    },
    {
      "id": "G-15",
      "story": "US-09",
      "title": "购物车为空时不显示角标（而不是显示 0）",
      "designMethod": "boundary",
      "expectTier": 1,
      "heldOut": true,
      "match": {
        "anyOf": ["购物车为空", "空购物车", "empty cart", "没有加入", "未加入任何"],
        "assertAnyOf": ["不显示", "no badge", "not displayed", "hidden", "不出现", "没有角标"]
      }
    },
    {
      "id": "G-16",
      "story": "US-10",
      "title": "从购物车移除一件后该行消失且角标减少",
      "designMethod": "state-transition",
      "expectTier": 1,
      "match": {
        "anyOf": ["移除", "remove", "删除商品", "从购物车移除"],
        "assertAnyOf": ["消失", "不再显示", "removed", "no longer", "减少", "1"]
      }
    },
    {
      "id": "G-17",
      "story": "US-11",
      "title": "结账第一步缺邮编时提示 Postal Code is required",
      "designMethod": "boundary",
      "expectTier": 1,
      "match": {
        "anyOf": ["邮编", "postal code", "zip", "邮政编码"],
        "assertAnyOf": ["postal code is required", "邮编是必填", "邮编必填", "需要邮编"]
      }
    },
    {
      "id": "G-18",
      "story": "US-12",
      "title": "订单税为小计的 8%，合计 = 小计 + 税",
      "designMethod": "calculation",
      "expectTier": 2,
      "match": {
        "anyOf": ["税", "tax", "小计", "item total", "总价", "合计"],
        "assertAnyOf": ["8%", "0.08", "43.18", "3.20", "小计+税", "subtotal + tax", "item total + tax"]
      }
    },
    {
      "id": "G-19",
      "story": "US-13",
      "title": "下单完成后显示 Thank you for your order!",
      "designMethod": "equivalence",
      "expectTier": 1,
      "match": {
        "anyOf": ["下单", "finish", "完成订单", "place the order", "结账完成", "checkout complete"],
        "assertAnyOf": ["thank you for your order", "感谢", "订单已", "checkout: complete"]
      }
    },
    {
      "id": "G-20",
      "story": "US-13",
      "title": "下单后购物车清空，角标不再显示",
      "designMethod": "state-transition",
      "expectTier": 1,
      "match": {
        "anyOf": ["下单后", "完成订单后", "after the order", "after checkout", "结账后"],
        "assertAnyOf": ["清空", "empty", "不再显示", "no badge", "角标"]
      }
    },
    {
      "id": "G-21",
      "story": "US-14",
      "title": "退出后回到登录页且无法再直接访问内页",
      "designMethod": "state-transition",
      "expectTier": 1,
      "match": {
        "anyOf": ["退出", "logout", "log out", "注销"],
        "assertAnyOf": ["登录页", "login", "only access", "/", "登录表单"]
      }
    }
  ]
}
