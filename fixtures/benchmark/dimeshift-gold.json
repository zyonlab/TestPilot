    },
    {
      "id": "D-08", "story": "注册", "title": "注册与登录之间可互相切换",
      "designMethod": "state-transition", "expectTier": 1, "heldOut": true,
      "match": { "anyOf": ["切换", "switch", "改为登录", "已有账号"],
                 "assertAnyOf": ["Sign In", "Registration", "登录", "注册"] }
    },
    {
      "id": "D-09", "story": "访问控制", "title": "未登录访问 /wallets 弹出登录框而非显示钱包",
      "designMethod": "negative", "expectTier": 1,
      "match": { "anyOf": ["未登录", "钱包", "wallets", "未授权", "拦截"],
