    },
    {
      "id": "D-11", "story": "弹窗", "title": "弹窗可关闭并回到原页面",
      "designMethod": "state-transition", "expectTier": 1,
      "match": { "anyOf": ["关闭", "close", "×", "取消", "退出弹窗"],
