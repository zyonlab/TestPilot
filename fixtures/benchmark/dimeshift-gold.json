{
  "id": "dimeshift-2019-04",
  "app": "dockercontainervm/dimeshift@sha256:0316bd172d772820c66b705b1c5aa706019e5eab941a4a9161d3e323e322af1f（tag non-empty-db）",
  "note": "人工编写的黄金清单。每一条行为都是**在真实浏览器里**（Playwright + Accept-Language: en）实测出来的：登录/注册弹窗里的字段名、空提交后的报错原文、未登录访问 /wallets 的结果，全部抄自屏幕上真实渲染出来的文本。 有一处特别要记：这个应用的弹窗内容 `body.innerText` **抓不到**，第一版探测三次都只拿到弹窗后面那一页，看起来像「点了没反应」。改成遍历可见叶子节点才拿到。写清单时被这个坑了一次，所以特意写在这里——**探测方法不对，会把「有」看成「没有」**。",
  "bias": "清单作者读过运行中的应用，所以它量的是「harness 能不能把这个产品拆成用例」，不量「能不能补上没人告诉过它的东西」。与另外两份同一个偏差。 另有一层与前两个应用不同、而且是好的一层：**dimeshift 上的探索修复只有一轮**（那一轮修的五个问题是它自己撞出来的），此外没有对着它调过任何提示词或参数。它是三个应用里最接近干净留出的一个。",
  "authGate": "**未登录时 `/wallets`、`/plans`、`/profile` 都会弹出登录框**，而不是显示内容。所以这份清单只覆盖不登录就能看到的部分。首页写着「we don't even ask you to register」指的是演示钱包，那条路径需要交互触发，不在清单里——一条要靠特定交互序列才能到达的行为，写进清单只会让这个数变成「探索会不会碰巧走对」。",
  "items": [
    {
      "id": "D-01", "story": "首页", "title": "首页展示产品主张与主导航",
      "designMethod": "equivalence", "expectTier": 1,
      "match": { "anyOf": ["首页", "landing", "home", "主页"],
                 "assertAnyOf": ["easiest way to track your expenses", "DimeShift", "记账"] }
    },
    {
      "id": "D-02", "story": "首页", "title": "导航含 Home / Contact / API / Register / Sign In",
      "designMethod": "equivalence", "expectTier": 1,
      "match": { "anyOf": ["导航", "nav", "菜单", "顶栏"],
                 "assertAnyOf": ["Sign In", "Register", "Contact", "登录"] }
    },
    {
      "id": "D-03", "story": "登录", "title": "点 Sign In 打开登录框，含用户名与密码字段",
      "designMethod": "state-transition", "expectTier": 1,
      "match": { "anyOf": ["登录框", "登录弹窗", "sign in", "打开登录"],
                 "assertAnyOf": ["Username or Email", "Password", "用户名"] }
    },
    {
      "id": "D-04", "story": "登录", "title": "空着提交登录提示 Invalid username or password",
      "designMethod": "negative", "expectTier": 1,
      "match": { "anyOf": ["空", "empty", "不填", "留空", "必填"],
                 "assertAnyOf": ["Invalid username or password", "用户名或密码", "无效"] }
    },
    {
      "id": "D-05", "story": "登录", "title": "凭证错误时提示 Invalid username or password",
      "designMethod": "negative", "expectTier": 1, "heldOut": true,
      "match": { "anyOf": ["错误", "invalid", "wrong", "不存在", "失败"],
                 "assertAnyOf": ["Invalid username or password", "用户名或密码", "无效"] }
    },
    {
      "id": "D-06", "story": "登录", "title": "登录框提供注册与找回密码入口",
      "designMethod": "equivalence", "expectTier": 1,
      "match": { "anyOf": ["注册入口", "找回", "restore", "忘记密码", "register"],
                 "assertAnyOf": ["Restore your password", "Register", "找回", "注册"] }
    },
    {
      "id": "D-07", "story": "注册", "title": "注册框含 Username / Email / Password 三个字段",
      "designMethod": "equivalence", "expectTier": 1,
      "match": { "anyOf": ["注册", "registration", "register", "新用户"],
