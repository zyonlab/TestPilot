{
  "$comment": "tier4-demo 的 P0：判据全打在 mock 清算接口上（kind:api）。第 1 条抓的就是那个故意留的四舍五入 bug。",
  "environment": {
    "name": "demo-local",
    "baseUrl": "http://127.0.0.1:5390/",
    "vars": {
      "DEMO_API": "http://127.0.0.1:5390/api/clearinghouse",
      "TP_RESET_CMD": "curl -s -X POST http://127.0.0.1:5390/api/reset"
    },
    "viewport": {
      "width": 1024,
      "height": 768
    },
    "login": {
      "authRequired": false,
      "steps": []
    }
  },
  "cases": [
    {
      "title": "Size 按步长截断：输入 0.0016 开仓后持仓等于 0.001",
      "priority": "P0",
      "priorityReason": "数量精度错一档就是十倍仓位；四舍五入而不是截断是真实交易所会拒绝的行为。",
      "type": "e2e",
      "tier": 1,
      "steps": [
        {
          "text": "点击 Market 标签"
        },
        {
          "text": "在 Size (BTC) 输入框输入 0.0016"
        },
        {
          "text": "点击 Place Order 按钮"
        }
      ],
      "expected": "接口里持仓 szi 等于 0.001（截断，不是 0.002）",
      "oracle": {
        "kind": "api",
        "url": "${env.DEMO_API}",
        "method": "GET",
        "path": "position.szi",
        "op": "eq",
        "value": 0.001,
        "settleMs": 500
      },
      "postSteps": [
        {
          "text": "点击 Close Position 按钮"
        }
      ]
    },
    {
      "title": "限价 10000 离参考价超过 80% 被拒且无挂单",
      "priority": "P0",
      "priorityReason": "价格带是资金保护。",
      "type": "e2e",
      "tier": 1,
      "steps": [
        {
          "text": "点击 Limit 标签"
        },
        {
          "text": "在 Price (USDC) 输入框输入 10000"
        },
        {
          "text": "在 Size (BTC) 输入框输入 0.001"
        },
        {
          "text": "点击 Place Order 按钮"
        }
      ],
      "expected": "接口里 orders 中没有 BTC 挂单",
      "oracle": {
        "kind": "api",
        "url": "${env.DEMO_API}",
        "method": "GET",
        "path": "orders[coin=BTC]",
        "op": "absent",
        "settleMs": 500
      },
      "postSteps": []
    },
    {
      "title": "杠杆设为 5x 后接口里的杠杆等于 5",
      "priority": "P0",
      "priorityReason": "杠杆决定强平价。",
      "type": "e2e",
      "tier": 1,
      "steps": [
        {
          "text": "把 Leverage 输入框的值改成 5"
        },
        {
          "text": "点击 Set Leverage 按钮"
        }
      ],
      "expected": "接口里 leverage 等于 5",
      "oracle": {
        "kind": "api",
        "url": "${env.DEMO_API}",
        "method": "GET",
        "path": "leverage",
        "op": "eq",
        "value": 5,
        "settleMs": 300
      },
      "postSteps": []
    },
    {
      "title": "平仓后接口里没有持仓",
      "priority": "P0",
      "priorityReason": "一键平仓是资金动作。",
      "type": "e2e",
      "tier": 1,
      "steps": [
        {
          "text": "点击 Market 标签，在 Size (BTC) 输入框输入 0.002，点击 Place Order 按钮"
        },
        {
          "text": "点击 Close Position 按钮"
        }
      ],
      "expected": "接口里 position 为 null",
      "oracle": {
        "kind": "api",
        "url": "${env.DEMO_API}",
        "method": "GET",
        "path": "position",
        "op": "absent",
        "settleMs": 300
      },
      "postSteps": []
    }
  ]
}
