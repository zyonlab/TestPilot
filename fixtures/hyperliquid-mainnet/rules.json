  "rules": [
    {
      "id": "R-ORDER-TYPE-LIMIT",
      "featureIds": [
        "order.type",
        "order.price"
      ],
      "claimType": "normative",
      "statement": "选择 Limit 后，面板要求一个限价价格；该价格是订单进入订单簿的挂单价。",
      "appliesWhen": "Hyperliquid /trade 永续",
      "sourceRefs": [
        "SRC-ORDER-TYPES"
      ],
      "riskFloor": "P1",
      "constants": {},
      "verification": {
        "kind": "ui-state",
        "expect": {
          "controlsPresent": [
            "Price"
          ],
          "stateChanged": [
            "Limit"
          ],
          "textPresent": []
        }
      }
    },
    {
      "id": "R-ORDER-TYPE-MARKET",
      "featureIds": [
        "order.type"
      ],
      "claimType": "normative",
      "statement": "Market 单立即以当前可成交价撮合，不接受挂单价。",
      "appliesWhen": "Hyperliquid /trade 永续",
      "sourceRefs": [
        "SRC-ORDER-TYPES"
      ],
      "riskFloor": "P1",
      "constants": {},
      "verification": {
        "kind": "ui-state",
        "expect": {
          "controlsPresent": [],
          "stateChanged": [
            "Market"
          ],
          "textPresent": []
        }
      }
    },
    {
      "id": "R-ORDER-TYPE-PRO",
      "featureIds": [
        "order.type"
      ],
      "claimType": "normative",
      "statement": "Pro 下拉提供 Scale、TWAP、Stop Limit、Stop Market 等高级订单类型；Stop 类需要触发价。",
      "appliesWhen": "Hyperliquid /trade 永续",
      "sourceRefs": [
        "SRC-ORDER-TYPES"
      ],
      "riskFloor": "P1",
      "constants": {},
      "verification": {
        "kind": "ui-state",
        "expect": {
          "controlsPresent": [],
          "stateChanged": [],
          "textPresent": [
            "TWAP|Scale|Stop"
          ]
        }
      }
    },
    {
      "id": "R-SIDE",
      "featureIds": [
        "order.side"
      ],
      "claimType": "normative",
      "statement": "方向只有做多与做空两种，切换后提交按钮与订单参数按该方向解释。",
      "appliesWhen": "Hyperliquid /trade 永续",
      "sourceRefs": [
        "SRC-ORDER-TYPES"
      ],
      "riskFloor": "P0",
      "constants": {},
      "verification": {
        "kind": "ui-state",
        "expect": {
          "controlsPresent": [],
          "stateChanged": [
            "Sell|Short"
          ],
          "textPresent": []
        }
      }
    },
    {
      "id": "R-TIF",
      "featureIds": [
        "order.tif"
      ],
      "claimType": "normative",
      "statement": "限价单的有效期为 GTC（挂到成交或撤销）、IOC（立即成交剩余取消）或 ALO（只做挂单，会跨价的直接拒绝）。",
      "appliesWhen": "Hyperliquid /trade 永续限价单",
      "sourceRefs": [
        "SRC-TIF"
      ],
      "riskFloor": "P1",
      "constants": {},
      "verification": {
        "kind": "ui-state",
        "expect": {
          "controlsPresent": [],
          "stateChanged": [],
          "textPresent": [
            "GTC|IOC|ALO"
          ]
        }
      }
    },
    {
      "id": "R-REDUCE-ONLY-UI",
      "featureIds": [
        "order.reduce-only"
      ],
      "claimType": "normative",
      "statement": "Reduce Only 是下单面板上的一个开关，勾选后该订单只用于减少既有仓位。",
      "appliesWhen": "Hyperliquid /trade 永续",
      "sourceRefs": [
        "SRC-ORDER-TYPES",
        "SRC-OBSERVED-2026-09-11"
      ],
      "riskFloor": "P0",
      "constants": {},
      "verification": {
        "kind": "ui-state",
        "expect": {
          "controlsPresent": [],
          "stateChanged": [
            "Reduce Only"
          ],
          "textPresent": []
        }
      }
    },
    {
      "id": "R-REDUCE-ONLY-EXEC",
      "featureIds": [
        "order.reduce-only",
        "position.close"
      ],
      "claimType": "normative",
      "statement": "Reduce Only 订单不得开新仓，也不得把仓位反向；成交后敞口按成交数量减少。",
      "appliesWhen": "Hyperliquid 永续",
      "sourceRefs": [
        "SRC-ORDER-TYPES"
      ],
      "riskFloor": "P0",
      "constants": {},
      "verification": {
        "kind": "api",
        "note": "需要可控持仓 fixture；用 clearinghouseState 的 assetPositions[position.coin=BTC].position.szi 做十进制精确比较，前后同账户同币种"
      }
    },
    {
      "id": "R-REDUCE-ONLY-OVERSIZE",
      "featureIds": [
        "order.reduce-only"
      ],
      "claimType": "hypothesis",
      "statement": "下单数量超过持仓时，Reduce Only 订单可能被拒绝，也可能被裁剪到持仓数量。",
      "appliesWhen": "行为未在文档中明确",
      "sourceRefs": [
        "SRC-ORDER-TYPES"
      ],
      "constants": {},
      "verification": {
        "kind": "open-question",
        "question": "超量 Reduce Only 是拒绝还是裁剪？需要产品规格或受控实测确认，不得臆定拒绝文案。"
      }
    },
    {
      "id": "R-TPSL",
      "featureIds": [
        "order.tpsl"
      ],
      "claimType": "normative",
      "statement": "勾选 Take Profit / Stop Loss 后，面板出现止盈价与止损价输入；它们生成随主订单一起提交的触发单。",
      "appliesWhen": "Hyperliquid /trade 永续",
      "sourceRefs": [
        "SRC-ORDER-TYPES",
        "SRC-OBSERVED-2026-09-11"
      ],
      "riskFloor": "P1",
      "constants": {},
      "verification": {
        "kind": "ui-state",
        "expect": {
          "controlsPresent": [
            "TP|Take Profit|Gain"
          ],
          "stateChanged": [
            "Take Profit|Stop Loss"
          ],
          "textPresent": []
        }
      }
    },
    {
      "id": "R-MARGIN-MODE",
      "featureIds": [
        "order.margin-mode"
      ],
      "claimType": "normative",
      "statement": "保证金模式分为全仓与逐仓；逐仓把该仓位的保证金与账户其余部分隔离。",
      "appliesWhen": "Hyperliquid 永续",
      "sourceRefs": [
        "SRC-MARGINING"
      ],
      "riskFloor": "P0",
      "constants": {},
      "verification": {
        "kind": "ui-state",
        "expect": {
          "controlsPresent": [],
          "stateChanged": [],
          "textPresent": [
            "Cross|Isolated|全仓|逐仓"
          ]
        }
      }
    },
    {
      "id": "R-MARGIN-MODE-EXEC",
      "featureIds": [
        "order.margin-mode"
      ],
      "claimType": "normative",
      "statement": "账户实际生效的保证金模式以清算接口为准，不以页面按钮文字为准。",
      "appliesWhen": "Hyperliquid 永续",
      "sourceRefs": [
        "SRC-INFO-API",
        "SRC-MARGINING"
      ],
      "riskFloor": "P0",
      "constants": {},
      "verification": {
        "kind": "api",
        "note": "clearinghouseState 的 assetPositions[position.coin=BTC].position.leverage.type"
      }
    },
    {
      "id": "R-LEVERAGE",
      "featureIds": [
        "order.leverage"
      ],
      "claimType": "normative",
      "statement": "杠杆按标的分档设上限，账户最终杠杆以清算接口为准；页面上的 40x 是本标的的上限展示。",
      "appliesWhen": "BTC-USDC 永续，观察于 2026-09-11",
      "sourceRefs": [
        "SRC-MARGINING",
        "SRC-OBSERVED-2026-09-11"
      ],
      "riskFloor": "P0",
      "constants": {
        "observedMax": "40"
      },
      "verification": {
        "kind": "api",
        "note": "clearinghouseState 的 position.leverage.value；上限值须按当时的标的元数据核对，不得把 40 当常量写死"
      }
    },
    {
      "id": "R-PRICE-PRECISION",
      "featureIds": [
        "order.price"
      ],
      "claimType": "normative",
      "statement": "价格受有效位数与小数位限制；不满足的价格不被接受。具体位数来自标的元数据。",
      "appliesWhen": "Hyperliquid 永续",
      "sourceRefs": [
        "SRC-TICK-LOT"
      ],
      "riskFloor": "P1",
      "unit": "USDC",
      "constants": {},
      "verification": {
        "kind": "api",
        "note": "先读该标的的 szDecimals 与价格规则，再构造边界值；不得从接口限制推断前端一定截断"
      }
    },
    {
      "id": "R-SIZE-PRECISION",
      "featureIds": [
        "order.size"
      ],
      "claimType": "normative",
      "statement": "数量的小数位由标的的 szDecimals 决定；超出的输入不被接受。",
      "appliesWhen": "Hyperliquid 永续",
      "sourceRefs": [
        "SRC-TICK-LOT"
      ],
      "riskFloor": "P0",
      "unit": "BTC",
      "constants": {},
      "verification": {
        "kind": "api",
        "note": "以标的元数据为准构造边界；成交数量用 clearinghouseState 精确比较"
      }
    },
    {
      "id": "R-SIZE-UNIT",
      "featureIds": [
        "order.size"
      ],
      "claimType": "observed",
      "statement": "观察到数量输入旁有标的单位与计价货币的切换；两种计量对应同一笔下单数量这一点尚未由产品文档确认。",
      "appliesWhen": "2026-09-11 观察；产品规则待确认",
