{
  "name": "testpilot-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:ws",
    "typecheck:app": "tsc --noEmit && node scripts/check-i18n.mjs",
    "typecheck:ws": "pnpm -r --filter './packages/**' --filter './apps/**' --filter './server' typecheck",
    "test": "pnpm -r --filter './packages/**' --filter './apps/**' --filter './server' test",
    "server:dev": "pnpm --filter testpilot-server dev",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:hooks": "node --test \"plugins/testpilot/hooks/test/*.test.mjs\"",
    "check:drift": "node scripts/check-drift.mjs",
    "build:claude-plugin": "node scripts/build-claude-plugin.mjs",
    "cost:report": "node scripts/cost-report.mjs",
    "doctor": "node scripts/testpilot-setup.mjs doctor",
    "setup": "node scripts/testpilot-setup.mjs install",
    "build:codex-plugin": "node scripts/build-codex-plugin.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@xyflow/react": "^12.11.3",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.1.0",
    "@rsbuild/plugin-react": "^1.0.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
