      "name": "订单与撤单",
      "parentId": null
    },
    {
      "id": "positions",
      "name": "持仓、盈亏与平仓",
      "parentId": null
    },
    {
      "id": "margin",
      "name": "杠杆、保证金与风险",
      "parentId": null
    }
  ],
  "features": [
    {
      "id": "account.inspect",
      "moduleId": "account",
      "name": "账户与资产",
      "applicability": "unresolved",
      "applicabilitySourceRefs": [
        "example"
      ]
    },
    {
      "id": "market.inspect",
      "moduleId": "market",
      "name": "币对与行情",
      "applicability": "unresolved",
      "applicabilitySourceRefs": [
        "example"
      ]
    },
    {
      "id": "orders.inspect",
      "moduleId": "orders",
      "name": "订单与撤单",
      "applicability": "unresolved",
      "applicabilitySourceRefs": [
