      "moduleId": "positions",
      "name": "持仓、盈亏与平仓",
      "applicability": "unresolved",
      "applicabilitySourceRefs": [
        "example"
      ]
    },
    {
      "id": "margin.inspect",
      "moduleId": "margin",
      "name": "杠杆、保证金与风险",
      "applicability": "unresolved",
      "applicabilitySourceRefs": [
        "example"
