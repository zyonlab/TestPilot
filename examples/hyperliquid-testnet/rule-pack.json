    },
    {
      "id": "market.select",
      "moduleId": "market",
      "name": "选择交易市场",
      "applicability": "unresolved",
      "applicabilitySourceRefs": [
        "example"
      ]
    },
    {
      "id": "orders.submit",
      "moduleId": "orders",
      "name": "配置并提交订单",
      "applicability": "unresolved",
      "applicabilitySourceRefs": [
        "example"
      ]
    },
    {
      "id": "orders.cancel",
      "moduleId": "orders",
      "name": "撤销未成交订单",
      "applicability": "unresolved",
      "applicabilitySourceRefs": [
        "example"
      ]
    },
    {
      "id": "orders.history",
      "moduleId": "orders",
      "name": "核对订单和成交历史",
      "applicability": "unresolved",
