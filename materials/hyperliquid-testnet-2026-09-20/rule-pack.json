  "rules": [
    {
      "id": "R01",
      "featureIds": [
        "wallet"
      ],
      "claimType": "normative",
      "statement": "测试登录必须采用注入钱包，并核对连接地址、网络和所选账户。",
      "sourceRefs": [
        "scope"
      ],
      "appliesWhen": "仅本测试网目标；记录实际账户/市场/模式并核对适用性",
      "verification": {
        "kind": "open-question",
        "question": "注入后的钱包地址是否匹配测试身份？连接入口与交易授权需首跑验证。"
      },
      "riskFloor": "P0"
    },
    {
      "id": "R02",
      "featureIds": [
        "authorization"
      ],
      "claimType": "hypothesis",
      "statement": "既有夹具使用Enable Trading后Establish Connection；本次新环境仍需确认。",
      "sourceRefs": [
        "login-fixture"
      ],
      "appliesWhen": "仅本测试网目标；记录实际账户/市场/模式并核对适用性",
      "verification": {
        "kind": "open-question",
        "question": "本次注入环境是否出现同样授权流程，拒签后是否没有委托？"
      }
    },
    {
      "id": "R03",
      "featureIds": [
        "assets"
      ],
      "claimType": "observed",
      "statement": "资产表区分总余额、可用余额和USDC估值。",
      "sourceRefs": [
        "ui"
      ],
      "appliesWhen": "仅本测试网目标；记录实际账户/市场/模式并核对适用性",
      "verification": {
        "kind": "ui-state",
        "expect": {
          "textPresent": [
            "Total Balance|Available Balance|USDC Value"
          ]
        }
      }
    },
    {
      "id": "R04",
      "featureIds": [
        "account-mode",
        "multi-position"
      ],
      "claimType": "normative",
      "statement": "Unified按结算/抵押币共享相关全仓余额，Manual按DEX分账。",
      "sourceRefs": [
