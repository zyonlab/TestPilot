# 复制成 server/.env 后按需改。这里只列会影响 harness 行为的开关，
# 每一条都写清楚"什么时候需要动它"——默认值适用于本机单实例开发。

# ---- Midscene 执行模型（Web 与宿主插件都需要）----
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=1234
MIDSCENE_MODEL_NAME=Qwen3.8-27B-4bit
# 也支持 MIDSCENE_MODEL_BASE_URL / MIDSCENE_MODEL_API_KEY，优先于以上旧别名。

# ---- Web 规划模型 ----
# Web 发起生成时由谁规划：claude-code（默认，用本机登录的 Claude Code）或 penguin（实验性，需 Node 24 与 Penguin 服务）
TP_AGENT_RUNTIME=claude-code
# 初始与执行模型保持一致，但独立配置。以后只改 TP_PLANNER_* 即可更换规划模型。
# Claude Code / Codex / PenguinHarness 插件继承宿主规划模型，不要求配置本段；
# 显式调用 A 模式 run_pipeline 时属于内部规划，需要本段。
TP_PLANNER_MODEL_NAME=Qwen3.8-27B-4bit
TP_PLANNER_BASE_URL=http://127.0.0.1:8000/v1
TP_PLANNER_API_KEY=1234
TP_PLANNER_THINK=0
TP_PLANNER_TIMEOUT_MS=900000
# 可选语义评估的独立模型名称，仍走 planner 的端点和凭证；默认使用 planner。
# TP_JUDGE_MODEL=
# 环境变量变更在服务重启后生效。Web 保存的项目配置优先于 env；
# 只希望通过 env 管理时，可直接使用设置页显示的环境配置，不必点击保存。

# 单次模型调用的上限（毫秒）。默认 900000（15 分钟）。
# 本地 27B 在长上下文 + 长输出时按分钟计，按托管端点调的超时会把"正常的慢"变成"崩"。
# 单次模型调用超时。不设就没有上限——真跑里出现过一次 635 秒才回来的调用（2026-09-07，docs/v3/06 §6）。
# 执行层一步定位/规划两分钟足够；生成类长任务另算。
TP_MODEL_TIMEOUT_MS=120000

# ---- 实例隔离（自举时才需要）----
# 自举要同时跑两个 TestPilot：一个在测，一个被测。它们绝不能共用一个库，
# 否则"删除项目"这类用例删的是真项目。
# TP_DATA_DIR=.data-selftest
# TP_INSTANCE=sut
# PORT=5401

# ---- 并发 ----
# 同时可开的浏览器数。上限由模型后端能扛住的并发决定，不是由机器决定。
# RUN_CONCURRENCY=2

# ---- Workflow budget (captured per attempt; native host planner remains host-controlled) ----
TP_PLANNER_MAX_CALLS=100
TP_EXECUTOR_MAX_CALLS=100
TP_RUN_MAX_MS=600000
# Local Web review needs no separate login or reviewer credential.
# Optional executable locations; never ship personal absolute paths in source.
# TP_CODEX_BIN=codex
# TP_CLAUDE_BIN=claude
# TP_PENGUIN_NODE=/path/to/node24
# TP_PENGUIN_BIN=/path/to/penguin

# Optional dated price table; absence remains unknown, never zero. See docs/v3/evidence/n-17.
# TP_MODEL_PRICES_FILE=/absolute/path/to/model-prices.json

# Additional trusted Web UI origins for reviewer sessions (comma separated). Localhost is allowed.
# TP_WEB_ORIGINS=https://testpilot.example.com

# Optional scoped execution memory; 0 disables future instruction snapshots.
TP_MEMORY_ENABLED=1
# Penguin evaluation companion. Keep the same directory in both processes.
# TP_EVOLUTION_DIR=/absolute/path/to/private/penguin-evaluation
# TP_EVOLUTION_PORT=7365
# TP_PENGUIN_EVALUATION_URL=http://127.0.0.1:7365
# TP_EVOLUTION_REVIEW_TOKEN=
# TP_EVOLUTION_RELEASE_MANIFEST=/absolute/path/to/private/release-runs.json
