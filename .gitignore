# dependencies
node_modules/

# build output
dist/
server/dist/

# runtime data — DB, encrypted secrets vault, settings, LLM-debug captures (SENSITIVE)
.data/
server/.data/
# 清库时旧数据是**移走**而不是删掉的（lineage 补不回来），备份目录同样带着密钥与整个库。
# 两种前缀都要挡：实测出现过 `.data.snapshot-*`，而当时的规则只写了 `.bak-`——
# 一个只挡住其中一种命名的规则，等于没挡：另一种照样会被 `git add -A` 收进去。
.data.bak-*/
server/.data.bak-*/
.data.snapshot-*/
server/.data.snapshot-*/

# Midscene run artifacts / caches / screenshots
midscene_run/
server/midscene_run/

# local wallet seeds (SENSITIVE — never commit)
.wallets/
server/.wallets/

# env files (may contain model keys / RPC secrets)
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# logs
*.log
npm-debug.log*

# OS
.DS_Store

# A self-test runs a second instance of the product; its state is not this repo's.
.data-selftest/

# 测试自己的数据目录：不隔离的话，每次 pnpm test 都会往真实运行列表里塞十几条假运行
server/.data-test/

# replay 重打分的副产物（score_run 每次都把条目写回运行目录）
benchmark/*/replay/*/score.json
